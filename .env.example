# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Модель Whisper для распознавания речи (опционально)
# Доступные: tiny (быстро), base, small (баланс), medium, large-v3 (точно)
WHISPER_MODEL=small

# Голос для озвучки (опционально)
# Доступные: xenia (женский), aidar (мужской), baya (женский), kseniya (женский), eugene (мужской)
TTS_SPEAKER=xenia
